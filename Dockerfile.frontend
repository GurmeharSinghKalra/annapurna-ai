FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# `public/` holds the service worker, web manifest, icon and OG image. The previous Dockerfile
# never copied it, so the production image advertised an installable offline PWA while serving a
# 404 for /sw.js and an HTML page for the manifest.
COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src
RUN npm run build

FROM nginx:1.27-alpine

RUN adduser -D -H -u 10001 annapurna
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
