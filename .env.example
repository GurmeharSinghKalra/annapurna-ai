# Copy to .env and fill in what you have. Every feature degrades honestly without its key:
# the app says what is missing rather than showing a placeholder as if it were real data.

# --- Environment -------------------------------------------------------------------
# development | test | production. Production refuses to start without JWT_SECRET
# and does not create database tables automatically.
APP_ENV=development

# --- Database ----------------------------------------------------------------------
# Leave blank for a local SQLite file at backend/data/annapurna.db.
# For hosted Postgres paste the provider's URL as-is; the libpq form is converted
# automatically, including ?sslmode=require.
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Authentication ----------------------------------------------------------------
# Required in production, minimum 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# --- Mandi prices: AGMARKNET via data.gov.in ---------------------------------------
# Free key from https://data.gov.in (register, then "Generate API key").
# Without it, crop economics use announced support prices, labelled as MSP.
AGMARKNET_API_KEY=
MARKET_CACHE_TTL_MINUTES=180
MARKET_TREND_WINDOW_DAYS=14

# --- Weather: OpenWeatherMap -------------------------------------------------------
# Free key from https://openweathermap.org/api
# Without it, weather screens show the farmer's own entered values, labelled as such.
OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=900

# --- Generative AI: Google Gemini --------------------------------------------------
# Free key from https://aistudio.google.com/apikey
# Without it, the advisor uses a fixed template and image screening returns 503
# rather than inventing a diagnosis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20

# --- Abuse control ------------------------------------------------------------------
# Per client per hour. 0 disables the limit.
AI_RATE_LIMIT_PER_HOUR=60
ANALYSIS_RATE_LIMIT_PER_HOUR=240

# --- CORS ---------------------------------------------------------------------------
# Browser origins allowed to call the API. In Docker the frontend proxies /api
# same-origin, so only the host port is needed.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
