# Copy to .env at the repository root. Never commit the real file.

# --- Optional integrations. The app runs without them and labels every fallback.
OPENWEATHER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AGMARKNET_SOURCE_URL=
ENAM_SOURCE_URL=

# --- Admin endpoints. /admin/summary returns 503 until this is set; requests
# must then send it as the X-Admin-Token header.
ADMIN_TOKEN=

# --- Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# --- Frontend build-time API URL. Vite inlines this at build time, so it must be
# set before `npm run build` or `docker compose build`, not at container start.
VITE_API_URL=http://127.0.0.1:8000

# --- Optional overrides.
# ANNAPURNA_DB_PATH=./backend/data/annapurna_ai.sqlite
# ANNAPURNA_MODEL_DIR=./backend/models
# SESSION_TTL_HOURS=336
# MAX_UPLOAD_BYTES=8388608
# LOGIN_ATTEMPT_LIMIT=10
# LOGIN_ATTEMPT_WINDOW_SECONDS=300
